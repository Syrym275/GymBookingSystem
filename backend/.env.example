# Backend environment variables. The backend does NOT read this file by itself:
# set each one in the terminal before starting uvicorn, e.g. in PowerShell
#   $env:APP_URL = "http://localhost:5173"

# PostgreSQL connection (required for everything except the public catalogue).
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/gym_booking

# Where the frontend runs. Verification emails link to {APP_URL}/verify-email?token=...
APP_URL=http://localhost:5173

# "console" prints emails in the backend terminal (development).
# "smtp" sends them. If unset: smtp when SMTP_HOST is set, otherwise console.
EMAIL_BACKEND=console

# Sender shown to recipients. Must be an address your SMTP provider lets you send from.
EMAIL_FROM=PulseGym <no-reply@example.kz>

# SMTP server. Port 587 uses STARTTLS, port 465 uses TLS from the start.
# Gmail: smtp.gmail.com, your Gmail address as SMTP_USER, and a 16-letter app password.
# Most providers (SES, Postmark, Resend, SendGrid, Mailtrap) also offer SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
